# ════════════════════════════════════════════════════════════════════════════════
#  Success Solar Care — Environment Template
#  Copy this file to .env and fill in real values. Never commit .env to git.
# ════════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Success Solar ERP"
APP_VERSION="1.0.0"
# Options: development | staging | production
ENVIRONMENT=development
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ssc_erp
# All tables live in this PostgreSQL 
POSTGRES_SCHEMA=solar

# Full async DSN — constructed from the parts above if not set
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── File Upload ────────────────────────────────────────────────────────────────
# Directory relative to project root for uploaded files
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=success-solar
MINIO_SECURE=false

# ── Seed / Dev Admin ──────────────────────────────────────────────────────────
# Default password assigned to all seeded employees (change before production)
SEED_DEFAULT_PASSWORD=SolarERP@2024

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
